# Postgres (docker compose reads these too)
DB_NAME=genosql
DB_USER=postgres
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=5434

# SELECT-only role that executes LLM-generated SQL (created by scripts/setup_db.py)
READER_USER=genosql_reader
READER_PASS=change-me-too

# LLM: "ollama" (local) or "openai" (any OpenAI-compatible endpoint)
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5-coder:3b
OLLAMA_HOST=http://localhost:11434
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=

# Tuning
# RAG_K=3
# MAX_ROWS=200
# MAX_REPAIR_ATTEMPTS=2
# STATEMENT_TIMEOUT_MS=15000
